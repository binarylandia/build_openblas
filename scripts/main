#!/usr/bin/env bash
#
# Usage: $0
#
# Build static OpenBLAS archives for CROSS_TARGET with the compilers of its
# build image, check them, and package them into .out/<build time>/. ./build
# runs this script in the image of the target, and hands
# wasm32-unknown-emscripten over to scripts/main-wasm. VARIANTS selects the
# variants (default: all four):
#
#   plain             single-threaded
#   threads           multi-threaded, up to 64 threads
#   relapack          single-threaded, with the recursive LAPACK routines of
#                     ReLAPACK in place of the LAPACK ones
#   threads-relapack  multi-threaded, with ReLAPACK
#
# The image provides the compilers and tools: CC (clang), FC (flang), HOSTCC
# (the compiler of the build machine, for the build tools of OpenBLAS), AR, NM,
# RANLIB, READELF, and TARGET_RUNNER, the command that runs a program of the
# target on the build machine (empty when it runs directly). Each archive holds
# libopenblas.a and the Fortran runtime libflang_rt.runtime.a of the flang that
# compiled LAPACK, so a program that links both needs no other runtime than the
# C library of the target.
#
# Examples:
#   CROSS_TARGET=x86_64-unknown-linux-gnu ./build
#   CROSS_TARGET=aarch64-unknown-linux-musl ./build 'VARIANTS="plain threads" ./scripts/main'
#
set -euo pipefail
trap "exit" INT

: "${CROSS_TARGET:? "$0: \$CROSS_TARGET is not set"}"

# shellcheck source=./lib.sh
source "${BASH_SOURCE%/*}/lib.sh"
# shellcheck source=./checks.sh
source "${BASH_SOURCE%/*}/checks.sh"

# WebAssembly has its own variants and checks.
if [[ "${CROSS_TARGET}" == "wasm32-unknown-emscripten" ]]; then
  exec "${BASH_SOURCE%/*}/main-wasm"
fi

NAME="openblas"
BUILD_DIR="$(abspath ".build")"
OUT_DIR="$(abspath ".out")"
INSTALL_ROOT="/opt/${NAME}"
build_time="${BUILD_TIME:-"$(date -u '+%Y-%m-%d_%H-%M-%S')"}"

export CFLAGS="-w -fPIC ${CFLAGS:-}"
export FFLAGS="-w -fPIC ${FFLAGS:-}"
export LDFLAGS="-fPIC ${LDFLAGS:-}"
if [[ "${CROSS_TARGET}" =~ (apple|darwin) ]]; then
  export CFLAGS="-mmacosx-version-min=${MACOSX_DEPLOYMENT_TARGET} ${CFLAGS}"
  export FFLAGS="-mmacosx-version-min=${MACOSX_DEPLOYMENT_TARGET} ${FFLAGS}"
  export LDFLAGS="-mmacosx-version-min=${MACOSX_DEPLOYMENT_TARGET} ${LDFLAGS}"
fi

export CCACHE_DIR="/cache/ccache"
export CCACHE_NOCOMPRESS="1"
export CCACHE_MAXSIZE="50G"

# The arm64 cores of the Linux archives, as DYNAMIC_LIST (OpenBLAS adds ARMV8,
# the baseline for any other CPU). It is the default DYNAMIC_CORE list of
# OpenBLAS without ARMV8SVE and ARMV9SME (ARM64_LINUX_EXCLUDED_CORES), plus the
# cores that the default list maps to other tables (CORTEXA55 to CORTEXA53;
# CORTEXA72, CORTEXA73, and FALKOR to CORTEXA57), which DYNAMIC_LIST would map
# to ARMV8 instead.
ARM64_LINUX_DYNAMIC_LIST="CORTEXA53 CORTEXA55 CORTEXA57 CORTEXA72 CORTEXA73 FALKOR NEOVERSEN1 NEOVERSEV1 NEOVERSEN2 A64FX THUNDERX THUNDERX2T99 TSV110 EMAG8180 THUNDERX3T110"

# The arm64 cores that the Linux archives leave out, so that their CPUs use
# other kernels:
#   ARMV8SVE  the generic SVE core, which OpenBLAS selects for SVE CPUs whose
#             part number it does not know. On the OpenBLAS commit of this
#             build, its SSYRK and SSYR2K results are wrong at SVE vector
#             lengths of 256 and 512 bits, and its DSYRK and DSYR2K results at
#             512 bits (sblat3 and dblat3 under qemu-aarch64 with
#             sve-default-vector-length=32 and 64, built by clang and by GCC);
#             the commit before OpenMathLib/OpenBLAS#5573 is wrong at 512 bits.
#             These CPUs use the ARMV8 kernels.
#   ARMV9SME  see NO_SME in build_variant
ARM64_LINUX_EXCLUDED_CORES="ARMV8SVE ARMV9SME"

# The level-3 BLAS tests of arm64 cores at SVE vector lengths, as
# <core>:<bytes>,...: the SVE cores, whose kernels depend on the vector length,
# at 128, 256, and 512 bits, and CORTEXA72, whose DGEMM kernel the default list
# of OpenBLAS leaves out, once. NEOVERSEV1 runs without 512 bits: its DSYRK and
# DSYR2K results are wrong there (dblat3), but OpenBLAS selects it only for
# Neoverse V1, whose SVE vector length is 256 bits.
ARM64_BLAS3_RUNS="NEOVERSEV1:16,32 NEOVERSEN2:16,32,64 A64FX:16,32,64 CORTEXA72:16"

VARIANTS="${VARIANTS:-plain threads relapack threads-relapack}"

# Print the make variables of a variant.
function variant_make_vars() {
  local variant="${1}"
  local threads="1"
  local use_thread="0"
  if [[ "${variant}" == threads* ]]; then
    threads="64"
    use_thread="1"
  fi
  # NUM_THREADS sets MAX_CPU_NUMBER, which sizes the work buffer table of
  # OpenBLAS. Unset, the build takes the core count of the build machine.
  printf '%s\n' "USE_THREAD=${use_thread}" "NUM_THREADS=${threads}" "USE_LOCKING=1"
  if [[ "${variant}" == *relapack ]]; then
    printf '%s\n' "BUILD_RELAPACK=1" "RELAPACK_REPLACE=1"
  fi
}

# Print the archive name suffix of a variant: plain has none.
function variant_flavor() {
  local variant="${1}"
  if [[ "${variant}" == "plain" ]]; then
    return
  fi
  printf -- '-%s\n' "${variant}"
}

# Adapt the unpacked source to the targets.
function prepare_source() {
  local src_dir="${1}"

  # shellcheck disable=SC2016 # the patterns match make variables literally
  sed -i -e 's|$(CC) -v |$(CC) |g' \
    -e 's|@echo "Building ReLAPACK library $(LIBNAME)"|@echo -n|g' \
    "${src_dir}/relapack/Makefile"

  # With RELAPACK_REPLACE=1, a ReLAPACK object takes the name of the OpenBLAS
  # object that it replaces in libopenblas.a (sgetrf.o). Its GEMMT objects
  # (sgemmt.o, dgemmt.o, cgemmt.o, zgemmt.o) thus replace the GEMMT of OpenBLAS
  # with the recursive GEMMT that the LDL factorizations of ReLAPACK use, which
  # fails the GEMMT unit tests of OpenBLAS: other argument errors, and wrong
  # cgemmt and zgemmt results when both operands are conjugate-transposed. Other
  # source names and INCLUDE_XGEMMT 0 keep that GEMMT inside ReLAPACK.
  local relapack_dir="${src_dir}/relapack"
  local precision
  for precision in s d c z; do
    mv "${relapack_dir}/src/${precision}gemmt.c" "${relapack_dir}/src/${precision}gemmt_relapack.c"
  done
  sed -i -E 's/(^|[[:space:]])([sdcz])gemmt\.c([[:space:]]|$)/\1\2gemmt_relapack.c\3/g' "${relapack_dir}/Makefile"
  sed -i 's|^#define INCLUDE_XGEMMT INCLUDE_ALL$|#define INCLUDE_XGEMMT 0|' "${relapack_dir}/relapack_config.h"
  if grep -qE '(^|[[:space:]])[sdcz]gemmt\.c' "${relapack_dir}/Makefile" ||
    ! grep -q '^#define INCLUDE_XGEMMT 0$' "${relapack_dir}/relapack_config.h"; then
    printf 'ERROR: %s builds the GEMMT of ReLAPACK under the OpenBLAS names; update the edit for this OpenBLAS version.\n' "${relapack_dir}" >&2
    return 1
  fi

  # dynamic_arm64.c detects SME with getauxval(AT_HWCAP2), but the headers of
  # glibc older than 2.18 do not define AT_HWCAP2, so the aarch64 glibc 2.17
  # build fails to compile it. Define it as the file already does for the HWCAP
  # bits; 26 is the value of the Linux auxiliary vector ABI, and getauxval
  # returns 0 for it on a kernel that does not provide it.
  local dynamic_arm64="${src_dir}/driver/others/dynamic_arm64.c"
  if ! grep -q '^#define AT_HWCAP2 ' "${dynamic_arm64}"; then
    sed -i '/^#define HWCAP2_SME 1<<23$/{n;a\
#ifndef AT_HWCAP2\
#define AT_HWCAP2 26\
#endif
}' "${dynamic_arm64}"
  fi
  if ! grep -q '^#define AT_HWCAP2 26$' "${dynamic_arm64}"; then
    printf 'ERROR: %s does not define AT_HWCAP2; update the edit for this OpenBLAS version.\n' "${dynamic_arm64}" >&2
    return 1
  fi

  # On macOS, OpenBLAS ends every x86_64 assembly kernel with the
  # .subsections_via_symbols directive, which lets the linker split a section
  # into one piece per symbol. The kernels name their branch targets with .L
  # labels, which are ordinary symbols in Mach-O (only L labels are local), so
  # the linker splits each function at its branch targets. Dead stripping
  # (rustc passes -dead_strip) and deduplication then drop the pieces that are
  # reached only by falling through, and the truncated kernel runs into
  # unrelated code. Without the directive, each kernel object stays whole.
  # https://github.com/OpenMathLib/OpenBLAS/issues/6089
  sed -i 's|^#define EPILOGUE\t\.subsections_via_symbols$|#define EPILOGUE|' "${src_dir}/common_x86_64.h"
  if grep -q 'subsections_via_symbols' "${src_dir}/common_x86_64.h"; then
    printf 'ERROR: %s still sets .subsections_via_symbols; update the edit for this OpenBLAS version.\n' "${src_dir}/common_x86_64.h" >&2
    return 1
  fi
}

# Print the archive members that set MH_SUBSECTIONS_VIA_SYMBOLS and define .L
# symbols in their code.
function macho_split_members() {
  local lib="${1}"
  local split
  local labeled
  split="$(llvm-readobj --file-headers "${lib}" |
    awk '/^File: / {m = $2; sub(/^.*\(/, "", m); sub(/\)$/, "", m)} /MH_SUBSECTIONS_VIA_SYMBOLS \(/ {print m}' |
    sort -u)" || return
  labeled="$(llvm-nm -A --defined-only "${lib}" |
    awk '$NF ~ /^\.L/ && $(NF-1) ~ /^[tT]$/ {split($1, a, ":"); print a[2]}' |
    sort -u)" || return
  comm -12 <(printf '%s\n' "${split}") <(printf '%s\n' "${labeled}")
}

# Fail when the archive lacks the dispatch table gotoblas_<core> of a core.
function check_kernel_cores() {
  local lib="${1}"
  shift
  local symbols
  symbols="$(archive_symbols "${lib}" --defined-only)" || return
  local core
  local missing=()
  for core in "$@"; do
    if ! grep -qx "gotoblas_${core}" <<<"${symbols}"; then
      missing+=("${core}")
    fi
  done
  if ((${#missing[@]} > 0)); then
    printf 'ERROR: %s lacks the kernels of: %s\n' "${lib}" "${missing[*]}" >&2
    return 1
  fi
}

# Name the Fortran runtime next to libopenblas.a in the pkg-config and CMake
# files of OpenBLAS, which name libopenblas.a alone. flang-rt locks its units
# with pthread mutexes, which glibc 2.17 keeps in libpthread.
function link_fortran_runtime() {
  local install_dir="${1}"
  local pc="${install_dir}/lib/pkgconfig/openblas.pc"
  local cmake="${install_dir}/lib/cmake/openblas/OpenBLASConfig.cmake"
  sed -i -e 's|^\(Libs: .*\)$|\1 -lflang_rt.runtime|' -e 's|^\(Libs.private: .*\)$|\1 -lpthread|' "${pc}"
  if ! grep -q '^Libs: .* -lflang_rt.runtime$' "${pc}" || ! grep -q '^SET(OpenBLAS_LIBRARIES ' "${cmake}"; then
    printf 'ERROR: %s or %s has an unknown layout; update link_fortran_runtime for this OpenBLAS version.\n' "${pc}" "${cmake}" >&2
    return 1
  fi
  # shellcheck disable=SC2016 # a CMake variable, expanded by CMake
  printf '%s\n' 'list(APPEND OpenBLAS_LIBRARIES ${_OpenBLAS_ROOT_DIR}/lib/libflang_rt.runtime.a)' >>"${cmake}"
}

# Fail when the archive has the dispatch table gotoblas_<core> of a core that
# the build leaves out.
function check_kernel_cores_absent() {
  local lib="${1}"
  shift
  local symbols
  symbols="$(archive_symbols "${lib}" --defined-only)" || return
  local core
  local present=()
  for core in "$@"; do
    if grep -qx "gotoblas_${core}" <<<"${symbols}"; then
      present+=("${core}")
    fi
  done
  if ((${#present[@]} > 0)); then
    printf 'ERROR: %s has the kernels of the left-out cores: %s\n' "${lib}" "${present[*]}" >&2
    return 1
  fi
}

# Fail when a core list names a core that the build leaves out.
function check_excluded_cores() {
  local list="${1}"
  local excluded="${2}"
  local core
  for core in ${excluded}; do
    if [[ " ${list} " == *" ${core} "* ]]; then
      printf 'ERROR: the core list "%s" names %s, which the build leaves out\n' "${list}" "${core}" >&2
      return 1
    fi
  done
}

# Run the checks of OpenBLAS on an installed archive.
function check_archive() {
  local install_dir="${1}"
  local work_dir="${2}"
  shift 2
  local cores=("$@")
  local lib="${install_dir}/lib/libopenblas.a"

  # Reject legacy .ctors/.dtors constructors. GNU ld folds them into
  # .init_array, but lld (by design) does not, so a constructor such as
  # OpenBLAS's DYNAMIC_ARCH gotoblas_init silently never runs and the first
  # BLAS call dereferences a null dispatch table.
  if [[ ! "${CROSS_TARGET}" =~ (apple|darwin) ]] && "${READELF}" -SW "${lib}" | grep -qE '\.(ctors|dtors)'; then
    printf 'ERROR: %s contains legacy .ctors/.dtors sections; constructors will not run under lld.\n' "${lib}" >&2
    return 1
  fi

  # Reject Mach-O objects that the linker would split at their .L labels (see
  # prepare_source).
  if [[ "${CROSS_TARGET}" =~ (apple|darwin) ]]; then
    local split_members
    if ! split_members="$(macho_split_members "${lib}")"; then
      printf 'ERROR: cannot read the objects of %s\n' "${lib}" >&2
      return 1
    fi
    if [[ -n "${split_members}" ]]; then
      printf 'ERROR: %s has objects with MH_SUBSECTIONS_VIA_SYMBOLS and .L symbols; the linker splits their functions:\n%s\n' "${lib}" "${split_members}" >&2
      return 1
    fi
  fi

  # Reject an archive without the kernels of a requested core. OpenBLAS can
  # leave out a core without an error when its compiler checks fail (NO_SVE,
  # NO_SME, NO_AVX512), and the dispatch then uses an older core.
  if ((${#cores[@]} > 0)); then
    check_kernel_cores "${lib}" "${cores[@]}" || return
  fi

  check_fortran_runtime "${lib}" "${install_dir}/lib/libflang_rt.runtime.a" || return
  check_consumer "${install_dir}" "${work_dir}" ${cores[@]+"${cores[@]}"} || return
}

function build_variant() {
  local variant="${1}"
  local flang_rt="${2}"
  local flavor
  flavor="$(variant_flavor "${variant}")"
  local build_dir="${BUILD_DIR}/${CROSS_TARGET}${flavor}"
  local src_dir="${build_dir}/${NAME}-${OPENBLAS_VERSION}"
  local install_dir="${INSTALL_ROOT}/${CROSS_TARGET}${flavor}"
  local outdir="${OUT_DIR}/${build_time}"
  local build_log="${build_dir}/${build_time}-build.log"
  mkdir -p "${build_dir}" "${outdir}"
  rm -rf "${install_dir}"

  fetch_source "${OPENBLAS_SOURCE_URL}" "${OPENBLAS_SOURCE_SHA256}" "${build_dir}/${OPENBLAS_COMMIT}.tar.gz" "${src_dir}"
  prepare_source "${src_dir}"

  # For explanation of build variables, see
  # https://github.com/OpenMathLib/OpenBLAS/wiki/WIP---Build-system-overview-(community-made)
  local make_vars=(
    "CC=ccache ${CC}"
    "FC=${FC}"
    "HOSTCC=${HOSTCC}"
    "AR=${AR}"
    "RANLIB=${RANLIB}"
    BINARY=64
    CROSS=1
    DYNAMIC_ARCH=1
    FIXED_LIBNAME=1
    NO_LAPACK=0
    NO_LAPACKE=0
    NOFORTRAN=0
    NO_AFFINITY=1
    NO_WARMUP=1
    BUILD_SHARED=0
    BUILD_STATIC=1
    NO_SHARED=1
    NO_STATIC=0
    USE_OPENMP=0
    NUM_PARALLEL=1
  )
  local line
  while IFS= read -r line; do
    make_vars+=("${line}")
  done < <(variant_make_vars "${variant}")

  local cores=()
  local excluded_cores=()
  local blas3_runs=()
  case "${CROSS_TARGET}" in
  aarch64-apple* | aarch64-darwin*)
    make_vars+=(TARGET=VORTEX)
    ;;
  aarch64*)
    check_excluded_cores "${ARM64_LINUX_DYNAMIC_LIST}" "${ARM64_LINUX_EXCLUDED_CORES}"
    make_vars+=(TARGET=ARMV8 "DYNAMIC_LIST=${ARM64_LINUX_DYNAMIC_LIST}")
    read -ra cores <<<"ARMV8 ${ARM64_LINUX_DYNAMIC_LIST}"
    read -ra excluded_cores <<<"${ARM64_LINUX_EXCLUDED_CORES}"
    read -ra blas3_runs <<<"${ARM64_BLAS3_RUNS}"
    ;;
  x86_64*)
    local dynamic_list
    dynamic_list="$("${BASH_SOURCE%/*}/get_x86_archs" <"${src_dir}/TargetList.txt")"
    make_vars+=(TARGET=HASWELL "DYNAMIC_LIST=${dynamic_list}")
    read -ra cores <<<"PRESCOTT ${dynamic_list}"
    ;;
  esac
  # NO_SME leaves out the ARMV9SME core, and SME CPUs use the kernels of their
  # SVE or Neoverse N1 core. The single-precision direct kernels of ARMV9SME
  # (SGEMM, SSYMM, SSYRK, SSYR2K, STRMM) return without computing when GCC
  # compiles them (OpenMathLib/OpenBLAS#6099). Compiled by clang, its GEMM
  # kernels compute correct dgemm and sgemm results only with a streaming
  # vector length of 512 bits, as on Apple M4, and wrong ones with 128, 256,
  # 1024, and 2048 bits, while the dispatch selects the core on any CPU with
  # SME.
  if [[ "${CROSS_TARGET}" == aarch64* ]]; then
    make_vars+=(NO_SME=1)
  fi
  if [[ "${CROSS_TARGET}" =~ (mingw|windows) ]]; then
    make_vars+=(CONSISTENT_FPCSR=1)
  fi

  # The library targets only: the default target also links the test programs,
  # which the tests below link with the link flags of the target.
  ${NICE} make -C "${src_dir}" -s libs netlib re_lapack "${make_vars[@]}" 2>&1 | log "${build_log}" | "${BASH_SOURCE%/*}/no_noise"
  ${NICE} make -C "${src_dir}" -s install PREFIX="${install_dir}" "${make_vars[@]}" 2>&1 | log "${build_log}" | "${BASH_SOURCE%/*}/no_noise"

  install -m 0644 "${flang_rt}" "${install_dir}/lib/libflang_rt.runtime.a"
  install -D -m 0644 "${LLVM_DIR:?}/share/doc/flang-rt/LICENSE.TXT" "${install_dir}/share/doc/flang-rt/LICENSE.TXT"
  link_fortran_runtime "${install_dir}"

  check_archive "${install_dir}" "${build_dir}/check" ${cores[@]+"${cores[@]}"}
  if ((${#excluded_cores[@]} > 0)); then
    check_kernel_cores_absent "${install_dir}/lib/libopenblas.a" "${excluded_cores[@]}"
  fi

  check_direct_execution "${build_dir}/check/consumer-check"
  ${NICE} make -C "${src_dir}" -s tests "${make_vars[@]}" CROSS=0 LDFLAGS="${LDFLAGS} $(program_link_flags)" 2>&1 |
    log "${build_log}" | "${BASH_SOURCE%/*}/no_noise"
  if ((${#blas3_runs[@]} > 0)); then
    check_blas3_vector_lengths "${src_dir}/test" "${build_dir}/blas3" "${blas3_runs[@]}"
  fi

  local archive="${outdir}/${NAME}-static${flavor}-${OPENBLAS_VERSION}-${CROSS_TARGET}-${build_time}.tar.xz"
  package "${install_dir}" "${archive}"
  write_metadata "${archive}" "$(variant_metadata "${variant}" "${install_dir}")"
  printf 'Built %s\n' "${archive##*/}"
}

# Print the metadata fields of an archive as a JSON object.
function variant_metadata() {
  local variant="${1}"
  local install_dir="${2}"
  local contents
  contents="$(find "${install_dir}" -type f -printf '%P\n' | LC_ALL=C sort | jq -R . | jq -s .)"
  jq -n \
    --arg variant "${variant}" \
    --arg openblas "${OPENBLAS_VERSION}" \
    --arg openblas_commit "${OPENBLAS_COMMIT}" \
    --arg source "${OPENBLAS_SOURCE_URL}" \
    --arg source_sha256 "${OPENBLAS_SOURCE_SHA256}" \
    --arg compiler "$(${CC} --version | head -1)" \
    --arg fortran_compiler "$(${FC} --version | head -1)" \
    --arg llvm "${LLVM_RELEASE:?}" \
    --arg llvm_source "${LLVM_SOURCE:?}" \
    --arg llvm_source_sha256 "${LLVM_SOURCE_SHA256:?}" \
    --arg target_toolchain "${TARGET_TOOLCHAIN_URL:?}" \
    --arg target_toolchain_sha256 "${TARGET_TOOLCHAIN_SHA256:?}" \
    --arg flang_rt_sha256 "$(sha256sum "${install_dir}/lib/libflang_rt.runtime.a" | cut -d' ' -f1)" \
    --argjson contents "${contents}" \
    '{
      kind: "native",
      variant: $variant,
      openblas: $openblas,
      openblas_commit: $openblas_commit,
      source: $source,
      source_sha256: $source_sha256,
      compiler: $compiler,
      fortran_compiler: $fortran_compiler,
      llvm: $llvm,
      target_toolchain: {
        url: $target_toolchain,
        sha256: $target_toolchain_sha256
      },
      flang_rt: {
        file: "lib/libflang_rt.runtime.a",
        sha256: $flang_rt_sha256,
        source: $llvm_source,
        source_sha256: $llvm_source_sha256,
        build_script: "docker/files/build-llvm-runtimes"
      },
      contents: $contents
    }'
}

main() {
  local variant
  for variant in ${VARIANTS}; do
    case "${variant}" in
    plain | threads | relapack | threads-relapack) ;;
    *)
      printf 'ERROR: unknown variant "%s" in VARIANTS; known: plain threads relapack threads-relapack\n' "${variant}" >&2
      exit 1
      ;;
    esac
  done
  : "${CC:?CC names the C compiler of the target}"
  : "${FC:?FC names the Fortran compiler of the target}"
  : "${HOSTCC:?HOSTCC names the C compiler of the build machine}"
  : "${AR:?}" "${NM:?}" "${RANLIB:?}" "${READELF:?}"

  local flang_rt
  flang_rt="$(${CC} -print-file-name=libflang_rt.runtime.a)"
  if [[ ! -f "${flang_rt}" ]]; then
    printf 'ERROR: %s finds no libflang_rt.runtime.a for %s\n' "${CC}" "${CROSS_TARGET}" >&2
    exit 1
  fi

  for variant in ${VARIANTS}; do
    build_variant "${variant}" "${flang_rt}"
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
