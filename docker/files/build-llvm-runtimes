#!/usr/bin/env bash
#
# Usage: $0 <LLVM source tarball> <target triple>
#
# Build the parts of LLVM that clang and flang need to compile and link
# programs for a target, from the source release of the installed LLVM, and
# install them where the drivers look for them:
#
#   include/flang/*.mod                      Fortran intrinsic modules
#   lib/clang/<major>/lib/<dir>/libflang_rt.runtime.a
#                                            Fortran runtime
#   lib/clang/<major>/lib/<dir>/libclang_rt.builtins.a
#                                            compiler-rt builtins (Linux only)
#
# <dir> is the target triple on Linux and Windows, and darwin on macOS. The
# macOS and MinGW toolchains ship their compiler-rt builtins, so only Linux
# targets build them here.
#
# flang reads the intrinsic modules (iso_c_binding, ieee_arithmetic, and
# others) only from the include/flang directory next to its executable, and
# their contents depend on the target: the x86_64 modules of the release declare
# REAL(KIND=10), which flang rejects for aarch64. The modules are rebuilt for the
# target in place, so an installation of LLVM compiles Fortran for one target.
# The CUDA, PowerPC, and OpenMP modules of the release stay as they are.
#
# Both are static archives of position-independent code. flang-rt has no shared
# library and no REAL(16) math, which would need libquadmath. The flang driver
# links the builtins after libgcc on aarch64 Linux, so a Fortran program links
# only when the builtins of the target exist.
#
# The compilers are clang, clang++, and flang of LLVM_DIR (default /opt/llvm)
# with --target=<triple>, which load the configuration files <triple>.cfg or
# <triple>-flang.cfg from the bin directory of LLVM_DIR (sysroot, GCC
# installation, linker). On macOS, C and C++ go through the osxcross wrappers
# <triple>-clang and <triple>-clang++ on PATH, which add the SDK and its C++
# headers, and SDKROOT and MACOSX_DEPLOYMENT_TARGET name the SDK and the oldest
# macOS version.
#
# The patches of PATCHES_DIR/llvm-<version>/flang-rt/*.patch (default
# /usr/local/share/build-llvm-runtimes/patches), where <version> is the version
# of the source tarball, apply to the source in the order of their names, and
# go into share/doc/flang-rt/patches/ next to the license of flang-rt. The
# patches of one LLVM version do not apply to another one: a version without
# such a directory builds the unchanged source.
#
# Examples:
#   $0 /tmp/llvm-project-22.1.8.src.tar.xz aarch64-unknown-linux-gnu
#   $0 /tmp/llvm-project-22.1.8.src.tar.xz arm64-apple-darwin20.2
#   $0 /tmp/llvm-project-22.1.8.src.tar.xz x86_64-w64-mingw32
#
set -euo pipefail
trap "exit" INT

LLVM_DIR="${LLVM_DIR:-/opt/llvm}"
PATCHES_DIR="${PATCHES_DIR:-/usr/local/share/build-llvm-runtimes/patches}"

# The parts of the LLVM source tree that the runtimes build reads.
SOURCE_PARTS=(cmake runtimes llvm/cmake llvm/utils/llvm-lit third-party compiler-rt flang flang-rt)

function extract_source() {
  local tarball="${1}"
  local src_dir="${2}"
  local top
  top="$(basename "${tarball}")"
  top="${top%.tar.xz}"
  local parts=()
  local part
  for part in "${SOURCE_PARTS[@]}"; do
    parts+=("${top}/${part}")
  done
  mkdir -p "${src_dir}"
  tar -xJf "${tarball}" -C "${src_dir}" --strip-components=1 "${parts[@]}"
}

# Print the LLVM version of a source tarball: 22.1.8 for
# llvm-project-22.1.8.src.tar.xz.
function source_version() {
  local name
  name="$(basename "${1}")"
  name="${name#llvm-project-}"
  printf '%s\n' "${name%.src.tar.xz}"
}

# Apply the flang-rt patches of an LLVM version to the source, exactly (without
# fuzz), and copy the applied patches into a directory.
function apply_patches() {
  local src_dir="${1}"
  local version="${2}"
  local applied_dir="${3}"
  local patch_dir="${PATCHES_DIR}/llvm-${version}/flang-rt"
  mkdir -p "${applied_dir}"
  if [[ ! -d "${patch_dir}" ]]; then
    printf 'No flang-rt patches for LLVM %s in %s\n' "${version}" "${PATCHES_DIR}"
    return
  fi
  local list
  list="$(find "${patch_dir}" -maxdepth 1 -name '*.patch' | LC_ALL=C sort)" || return
  local patches=()
  mapfile -t patches <<<"${list}"
  local patch_file
  for patch_file in "${patches[@]}"; do
    [[ -n "${patch_file}" ]] || continue
    printf 'Applying %s\n' "${patch_file}"
    patch --directory="${src_dir}" --strip=1 --forward --batch --fuzz=0 \
      --no-backup-if-mismatch --input="${patch_file}" || return
    cp "${patch_file}" "${applied_dir}/"
  done
}

# The intrinsic modules that the flang build generates with -fsyntax-only, in
# the order of their dependencies, without the CUDA and PowerPC ones.
INTRINSIC_MODULES=(
  __fortran_builtins
  __fortran_type_info
  __fortran_ieee_exceptions
  ieee_exceptions
  ieee_arithmetic
  ieee_features
  iso_c_binding
  iso_fortran_env_impl
  iso_fortran_env
  flang_debug
)

# Rebuild the intrinsic modules for the target, without the REAL(KIND=16)
# procedures (the -DFLANG_SUPPORT_R16 of the flang build), because flang-rt is
# built without REAL(16) math.
function build_intrinsic_modules() {
  local src_dir="${1}"
  local triple="${2}"
  local module
  for module in "${INTRINSIC_MODULES[@]}"; do
    "${LLVM_DIR}/bin/flang" --target="${triple}" -cpp -fsyntax-only \
      -module-dir "${LLVM_DIR}/include/flang" "${src_dir}/flang/module/${module}.f90"
  done
}

# Print the CMake arguments that select the compilers and the system of the
# target, and the runtimes to build.
function target_cmake_args() {
  local triple="${1}"
  local bin="${LLVM_DIR}/bin"
  local arch="${triple%%-*}"
  local fortran=(
    -DCMAKE_Fortran_COMPILER="${bin}/flang"
    -DCMAKE_Fortran_COMPILER_TARGET="${triple}"
  )
  local clang=(
    -DCMAKE_C_COMPILER="${bin}/clang"
    -DCMAKE_C_COMPILER_TARGET="${triple}"
    -DCMAKE_CXX_COMPILER="${bin}/clang++"
    -DCMAKE_CXX_COMPILER_TARGET="${triple}"
    -DCMAKE_ASM_COMPILER_TARGET="${triple}"
  )
  case "${triple}" in
  *-linux-*)
    printf '%s\n' "${clang[@]}" "${fortran[@]}" \
      -DCMAKE_SYSTEM_NAME=Linux \
      -DCMAKE_SYSTEM_PROCESSOR="${arch}" \
      -DLLVM_DEFAULT_TARGET_TRIPLE="${triple}" \
      -DLLVM_ENABLE_RUNTIMES="compiler-rt;flang-rt"
    ;;
  *-apple-darwin*)
    local wrapper
    wrapper="$(command -v "${triple}-clang")" || {
      printf 'ERROR: no osxcross wrapper %s-clang on PATH\n' "${triple}" >&2
      return 1
    }
    printf '%s\n' "${fortran[@]}" \
      -DCMAKE_C_COMPILER="${wrapper}" \
      -DCMAKE_CXX_COMPILER="${wrapper}++" \
      -DCMAKE_SYSTEM_NAME=Darwin \
      -DCMAKE_SYSTEM_PROCESSOR="${arch}" \
      -DCMAKE_OSX_SYSROOT="${SDKROOT:?SDKROOT names the macOS SDK}" \
      -DCMAKE_OSX_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET:?MACOSX_DEPLOYMENT_TARGET names the oldest macOS version}" \
      -DLLVM_DEFAULT_TARGET_TRIPLE="${triple}" \
      -DLLVM_ENABLE_RUNTIMES="flang-rt"
    ;;
  *-w64-mingw32)
    # The library directory of the drivers is named by the normalized triple
    # (x86_64-w64-windows-gnu).
    local normalized
    normalized="$("${bin}/clang" --target="${triple}" -print-target-triple)" || return
    printf '%s\n' "${clang[@]}" "${fortran[@]}" \
      -DCMAKE_SYSTEM_NAME=Windows \
      -DCMAKE_SYSTEM_PROCESSOR="${arch}" \
      -DLLVM_DEFAULT_TARGET_TRIPLE="${normalized}" \
      -DLLVM_ENABLE_RUNTIMES="flang-rt"
    ;;
  *)
    printf 'ERROR: no runtimes build for %s\n' "${triple}" >&2
    return 1
    ;;
  esac
}

function configure() {
  local src_dir="${1}"
  local build_dir="${2}"
  local triple="${3}"
  local bin="${LLVM_DIR}/bin"
  local resource_dir
  resource_dir="$("${bin}/clang" -print-resource-dir)"
  local args
  args="$(target_cmake_args "${triple}")" || return
  local target_args=()
  mapfile -t target_args <<<"${args}"
  cmake -S "${src_dir}/runtimes" -B "${build_dir}" \
    "${target_args[@]}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${LLVM_DIR}" \
    -DCMAKE_Fortran_COMPILER_WORKS=ON \
    -DCMAKE_AR="${bin}/llvm-ar" \
    -DCMAKE_NM="${bin}/llvm-nm" \
    -DCMAKE_RANLIB="${bin}/llvm-ranlib" \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON \
    -DLLVM_INCLUDE_TESTS=OFF \
    -DLLVM_INCLUDE_DOCS=OFF \
    -DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON \
    -DCOMPILER_RT_BUILD_BUILTINS=ON \
    -DCOMPILER_RT_BUILD_CRT=OFF \
    -DCOMPILER_RT_BUILD_CTX_PROFILE=OFF \
    -DCOMPILER_RT_BUILD_GWP_ASAN=OFF \
    -DCOMPILER_RT_BUILD_LIBFUZZER=OFF \
    -DCOMPILER_RT_BUILD_MEMPROF=OFF \
    -DCOMPILER_RT_BUILD_ORC=OFF \
    -DCOMPILER_RT_BUILD_PROFILE=OFF \
    -DCOMPILER_RT_BUILD_SANITIZERS=OFF \
    -DCOMPILER_RT_BUILD_XRAY=OFF \
    -DCOMPILER_RT_INCLUDE_TESTS=OFF \
    -DCOMPILER_RT_INSTALL_PATH="${resource_dir}" \
    -DFLANG_RT_ENABLE_SHARED=OFF \
    -DFLANG_RT_ENABLE_STATIC=ON \
    -DFLANG_RT_INCLUDE_TESTS=OFF \
    -DFLANG_RT_INSTALL_RESOURCE_PATH="${resource_dir}" \
    -DFLANG_RUNTIME_F128_MATH_LIB=""
}

function build_and_install() {
  local build_dir="${1}"
  local triple="${2}"
  case "${triple}" in
  *-w64-mingw32)
    # On Windows, flang-rt builds one archive for each C runtime of MSVC
    # (flang_rt.runtime.static, .dynamic, and their debug variants), which
    # differ only when compiled for MSVC, while the MinGW driver links
    # -lflang_rt.runtime from the library directory of the target.
    cmake --build "${build_dir}" --parallel "$(nproc)" --target flang_rt.runtime.static
    local lib
    lib="$(find "${build_dir}" -name 'libflang_rt.runtime.static.a')" || return
    if [[ -z "${lib}" || "${lib}" == *$'\n'* ]]; then
      printf 'ERROR: expected one libflang_rt.runtime.static.a in %s, found: %s\n' "${build_dir}" "${lib:-none}" >&2
      return 1
    fi
    local resource_dir
    local normalized
    resource_dir="$("${LLVM_DIR}/bin/clang" -print-resource-dir)" || return
    normalized="$("${LLVM_DIR}/bin/clang" --target="${triple}" -print-target-triple)" || return
    install -D -m 0644 "${lib}" "${resource_dir}/lib/${normalized}/libflang_rt.runtime.a"
    ;;
  *)
    cmake --build "${build_dir}" --parallel "$(nproc)"
    cmake --install "${build_dir}"
    ;;
  esac
}

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  [[ "${1:-}" =~ ^(-h|--help)$ ]] && {
    show_help
    exit 0
  }
  (($# == 2)) || {
    show_help >&2
    exit 1
  }

  local tarball="${1}"
  local triple="${2}"
  local work_dir
  work_dir="$(mktemp -d)"
  # shellcheck disable=SC2064 # expand work_dir now, the variable is local
  trap "rm -rf '${work_dir}'" EXIT

  extract_source "${tarball}" "${work_dir}/src"
  apply_patches "${work_dir}/src" "$(source_version "${tarball}")" "${work_dir}/patches"
  build_intrinsic_modules "${work_dir}/src" "${triple}"
  configure "${work_dir}/src" "${work_dir}/build" "${triple}"
  build_and_install "${work_dir}/build" "${triple}"
  install -D -m 0644 "${work_dir}/src/flang-rt/LICENSE.TXT" "${LLVM_DIR}/share/doc/flang-rt/LICENSE.TXT"
  local patch_file
  for patch_file in "${work_dir}/patches"/*.patch; do
    [[ -f "${patch_file}" ]] || continue
    install -D -m 0644 "${patch_file}" "${LLVM_DIR}/share/doc/flang-rt/patches/${patch_file##*/}"
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
