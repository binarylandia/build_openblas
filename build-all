#!/usr/bin/env bash
#
# Usage: $0 [target...]
#
# Build the native archives of the given targets with ./build, by default of
# every target whose build image has the clang and flang toolchain. JOBS
# targets build at a time (default 2): each target build uses every CPU, so more
# at once can run out of memory. All targets share one BUILD_TIME, so
# scripts/release publishes them together.
#
# Examples:
#   $0
#   JOBS=1 $0 x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu
#
set -euo pipefail
trap "exit" INT

DEFAULT_TARGETS=(
  "aarch64-unknown-linux-gnu"
  "aarch64-unknown-linux-musl"
  "x86_64-unknown-linux-gnu"
  "x86_64-unknown-linux-musl"
)

function run_one() {
  local target="${1:?}"
  printf "Building for %s\n" "${target}"
  CROSS_TARGET="${target}" ./build
}
export -f run_one

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  [[ "${1:-}" =~ ^(-h|--help)$ ]] && {
    show_help
    exit 0
  }

  local targets=("$@")
  if ((${#targets[@]} == 0)); then
    targets=("${DEFAULT_TARGETS[@]}")
  fi

  BUILD_TIME="${BUILD_TIME:-$(date -u '+%Y-%m-%d_%H-%M-%S')}"
  export BUILD_TIME

  # shellcheck disable=SC2016 # {= ... =} is a Perl expression of GNU parallel
  parallel --halt soon,fail=1 --line-buffer --tag \
    --tagstring '|{#}| \033[34m{= sprintf("%-26s", $_) =}\033[0m' \
    --jobs="${JOBS:-2}" \
    run_one ::: "${targets[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
