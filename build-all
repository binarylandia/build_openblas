#!/usr/bin/env bash

# Runs bulk cross-compilation for all supported platforms

set -euo pipefail

function abspath() {
  readlink -m "$1"
}

targets=(
  "aarch64-apple-darwin"
  "aarch64-unknown-linux-gnu"
  "aarch64-unknown-linux-musl"
  "x86_64-apple-darwin"
  "x86_64-pc-windows-gnu"
  "x86_64-unknown-linux-gnu"
  "x86_64-unknown-linux-musl"
)

# One build time for all targets, so scripts/release publishes them together.
BUILD_TIME="${BUILD_TIME:-$(date -u '+%Y-%m-%d_%H-%M-%S')}"
export BUILD_TIME

function run_one() {
  local target=${1:?}
  printf "Building for %s\n" "${target}"
  CROSS_TARGET=${target} BUILD_TIME=${BUILD_TIME} ./build
}
export -f run_one

# Each target build uses every CPU, so JOBS targets build at a time; more at once
# can run out of memory.
parallel --halt soon,fail=1 --line-buffer --tag --tagstring '|{#}| \033[34m{= sprintf("%-26s", $_) =}\033[0m' --jobs="${JOBS:-4}" \
  run_one ::: "${targets[@]}"
