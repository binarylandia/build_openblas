#!/usr/bin/env bash

set -euo pipefail

export BUILDKIT_PROGRESS=plain
export PROGRESS_NO_TRUNC=1

CROSS_TARGET="${CROSS_TARGET:?CROSS_TARGET names the target, for example CROSS_TARGET=x86_64-unknown-linux-gnu}"
DOCKERFILE="./dev/${CROSS_TARGET}.dockerfile"
[[ -f "${DOCKERFILE}" ]] || {
  printf 'ERROR: no build image for %s: %s does not exist\n' "${CROSS_TARGET}" "${DOCKERFILE}" >&2
  exit 1
}
BUILD_TIME="${BUILD_TIME:-"$(date -u '+%Y-%m-%d_%H-%M-%S')"}"

# The commit that the build runs, recorded in the metadata of each archive.
# scripts/release publishes only archives of a clean, pushed commit.
BUILD_COMMIT="$(git rev-parse HEAD)"
BUILD_DIRTY="false"
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  BUILD_DIRTY="true"
fi
# The time of the commit, used as the time of every archive entry.
SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)"
DOCKERFILE_SHA256="$(sha256sum "${DOCKERFILE}" | cut -d' ' -f1)"
DOCKER_REPO="openblas_builder"
DOCKER_IMAGE_NAME_SAFE="${DOCKER_REPO//\//-}-${CROSS_TARGET}"
DOCKER_CONTAINER_NAME="${DOCKER_IMAGE_NAME_SAFE}-$(date -u "+%Y-%m-%d_%H-%M-%S_%3NZ")"

USER="user"
GROUP="user"

docker build \
  --file="${DOCKERFILE}" \
  --tag="$DOCKER_IMAGE_NAME_SAFE" \
  --network=host \
  --build-arg="UID=$(id -u)" \
  --build-arg="GID=$(id -g)" \
  --build-arg="USER=${USER}" \
  --build-arg="GROUP=${GROUP}" \
  .

mkdir -p .build .cache/ccache .opt .out

tty_flags=()
if tty -s; then
  tty_flags=(--interactive --tty)
fi

docker run --rm "${tty_flags[@]}" \
  --init \
  --name="$DOCKER_CONTAINER_NAME" \
  --hostname="${DOCKER_IMAGE_NAME_SAFE}" \
  --user="$(id -u):$(id -g)" \
  --volume="$(pwd):/workdir" \
  --volume="$(pwd)/.opt:/opt/openblas" \
  --volume="$(pwd)/.cache/ccache:/cache/ccache" \
  --workdir="/workdir" \
  --env="CROSS_TARGET=${CROSS_TARGET}" \
  --env="BUILD_TIME=${BUILD_TIME}" \
  --env="BUILD_COMMIT=${BUILD_COMMIT}" \
  --env="BUILD_DIRTY=${BUILD_DIRTY}" \
  --env="SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}" \
  --env="DOCKERFILE_SHA256=${DOCKERFILE_SHA256}" \
  --env="UID=$(id -u)" \
  --env="GID=$(id -g)" \
  --env="USER=${USER}" \
  --env="GROUP=${GROUP}" \
  --env="PS1=\${USER}@\${HOST}" \
  --env="TZ=Etc/UTC" \
  --env="LANG=C.UTF-8" \
  --ulimit core=0 \
  "$DOCKER_IMAGE_NAME_SAFE" \
  bash -c "${*:-'./scripts/main'}"
